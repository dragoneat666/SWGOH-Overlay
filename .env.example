# Copy this to .env and fill in your own values before `docker compose up`

POSTGRES_USER=swgoh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=swgoh_overlay

# Shared bearer token the Android app (and any admin tooling) must send as
# `Authorization: Bearer <this value>`. Swap for real per-device tokens later
# if this ever needs to support more than you + one trusted friend.
API_TOKEN=change_me_too

# Port the backend API is published on (host side)
API_PORT=4001

# Comlink is self-hosted in this same compose stack — the backend talks to it
# over the internal Docker network, this shouldn't need to change.
COMLINK_URL=http://comlink:3000
