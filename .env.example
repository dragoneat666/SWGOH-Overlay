# Copy this to .env and fill in your own values before `docker compose up`

POSTGRES_USER=swgoh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=swgoh_overlay

# Shared bearer token the Android app and the web admin UI must send as
# `Authorization: Bearer <this value>` (the web UI asks for it once on its
# sign-in screen). Make it long and random. Swap for real per-device tokens
# later if this ever needs to support more than you + one trusted friend.
API_TOKEN=change_me_too

# Port the API + web admin UI are published on (host side)
API_PORT=4001

# Name Comlink sends to the game's API to identify this tool
COMLINK_APP_NAME=swgoh-overlay

# Comlink is self-hosted in this same compose stack — the backend talks to it
# over the internal Docker network, this shouldn't need to change.
COMLINK_URL=http://comlink:3000
